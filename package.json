{
  "name": "kokeb-games",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm check:boundaries && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @kokeb/db generate",
    "db:migrate": "pnpm --filter @kokeb/db migrate:dev",
    "db:deploy": "pnpm --filter @kokeb/db migrate:deploy"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~6.0.3",
    "vitest": "~4.1.12"
  }
}