# Postgres connection used by the app and by Prisma migrations.
# Neon: use the DIRECT connection string (host WITHOUT "-pooler"), from a dev
# branch for development. Never run tests against the production branch.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# ── Crash game server (apps/game-server) ───────────────────────────
# All optional in development (insecure defaults are used with a warning);
# CRASH_CHAIN_SECRET, CRASH_SALT and SESSION_SECRET are REQUIRED in production.

# Name players see for the crash game.
GAME_DISPLAY_NAME="Crash"
GAME_SERVER_PORT=4001

# Generates the provably-fair hash chain. Long random value; never change or
# leak it while its chain is in use. Generate: openssl rand -hex 32
CRASH_CHAIN_SECRET=
CRASH_CHAIN_LENGTH=1000000
# Public salt, chosen AFTER the chain commitment is published (e.g. a future
# Bitcoin block hash). Changing it changes every future result.
CRASH_SALT=
# House edge in basis points (300 = 3%).
CRASH_HOUSE_EDGE_BPS=300
CRASH_BETTING_MS=6000
CRASH_COOLDOWN_MS=3000

# Signs player session tokens. Generate: openssl rand -hex 32
SESSION_SECRET=

# ── Telegram ────────────────────────────────────────────────────────
# Bot token from @BotFather (/newbot). Used by the bot AND by the game server
# to verify Mini App logins. Keep it secret.
TELEGRAM_BOT_TOKEN=
# Public HTTPS address of the game page (Telegram only opens https Mini Apps).
# Local testing: run `cloudflared tunnel --url http://localhost:4001` and paste the https URL here.
MINI_APP_URL=
# Name the bot uses in its messages.
BRAND_NAME="Kokeb Games"
# Dev login and the free-ETB button are on outside production. Set to false to test
# exactly what players will see (login only through Telegram).
# DEV_TOOLS=false

# ── Jet crash game (page at /jet) ───────────────────────────────────
# A second crash game with its own rounds, chain and salt. Same rules as above.
JET_DISPLAY_NAME="Jet"
# Required in production. Generate: openssl rand -hex 32
JET_CHAIN_SECRET=
JET_CHAIN_LENGTH=1000000
JET_SALT=
JET_HOUSE_EDGE_BPS=300
JET_BETTING_MS=5000
# Bet panels per player.
JET_SLOTS=3

# ── 75-ball bingo (runs in the game server, page at /bingo) ─────────
BINGO_DISPLAY_NAME="75-Ball Bingo"
# Public seed that fixes every cartela's numbers (card #N is always the same card).
# Pick once before launch and never change it: players learn their favourite cartelas.
BINGO_DECK_SEED=kokeb-bingo-deck-v1
# House cut of each pot in basis points (2000 = 20%).
BINGO_COMMISSION_BPS=2000
BINGO_COUNTDOWN_MS=30000
BINGO_DRAW_INTERVAL_MS=3000
